/* ظˆط§ط¬ظ‡ط© ط§ظ„ط£ط¯ظˆط§ط± ط§ظ„ط­ظ‚ظٹظ‚ظٹط© (app.js + ui-*.js + roles.js ظپظٹ vm) ظ…طھطµظ„ط© ط¨ط§ظ„ط®ط§ط¯ظ… ط§ظ„ط­ظ‚ظٹظ‚ظٹ (erp-op ظˆ company-staff) ط¹ظ„ظ‰ ظ‚ط§ط¹ط¯ط© ظˆظ‡ظ…ظٹط©:
   ظƒظ„ ط¯ظˆط± ظٹط±ظ‰ ظ‚ط³ظ…ظ‡ ظپظ‚ط·طŒ ظˆطµظپط­ط§طھ ظ‚ط³ظ…ظ‡ طھظڈط¹ط±ط¶ ط¨ط¨ظٹط§ظ†ط§طھظ‡ط§ ط§ظ„طµط­ظٹط­ط©طŒ ظˆط£ط²ط±ط§ط± ظ…ط§ ظ„ط§ ظٹظ…ظ„ظƒظ‡ ظ„ط§ طھط¸ظ‡ط±طŒ ظˆظپط±ظٹظ‚ ط§ظ„ط¹ظ…ظ„ ظٹط¹ظ…ظ„ ظ„ظ„ظ…ط¯ظٹط± ظپظ‚ط·.
   ظ„ط§ ظٹط«ط¨طھ طھط®ط·ظٹط· ط§ظ„ظ…طھطµظپط­ ط§ظ„ظپط¹ظ„ظٹ. */
const { test } = require('node:test');
const assert = require('node:assert/strict');
const vm = require('node:vm');
const fs = require('node:fs');
const path = require('node:path');
const { createFakeDb, createRes } = require('./fake-admin-db');
const { factory } = require('./helpers');
const E = require('../js/erp-hr.js');
const Roles = require('../js/roles.js');

let adminDb;
let mails;
const tokens = {};
for (const [role, uid] of [['MANAGER', 'mgr-1'], ['HR', 'hr-1'], ['ACCOUNTANT', 'acc-1'], ['WAREHOUSE', 'wh-1'], ['SALES', 'sal-1']])
  tokens['tok-' + uid] = { uid, email: `${uid}@example.com`, email_verified: true, _role: role };

const firebasePath = require.resolve('../api/_lib/firebase-admin');
require.cache[firebasePath] = {
  id: firebasePath, filename: firebasePath, loaded: true,
  exports: { getFirebaseAdmin: async () => ({ auth: { verifyIdToken: async t => { if (!tokens[t]) throw Object.assign(new Error('x'), { code: 'auth/invalid-id-token' }); return tokens[t]; } }, database: adminDb.database }) }
};
const mailerPath = require.resolve('../api/_lib/mailer');
require.cache[mailerPath] = { id: mailerPath, filename: mailerPath, loaded: true, exports: { assertMailConfigured() { }, async sendMail(p) { mails.push(p); return { id: 'm' + mails.length }; } } };
process.env.APP_BASE_URL = 'https://nabdh.example.com';

const erpOp = require('../api/erp-op');
const staffApi = require('../api/company-staff');

const noop = () => { };
let seedN = 0;
const sctx = () => ({ opId: 'ui-seed-' + (++seedN), user: 'seed', now: '2026-11-14T10:00:00Z', today: '2026-11-14' });

function seed() {
  const s = factory();
  let d = s.db;
  const go = (op, i) => { const r = E.apply(d, sctx(), op, i); d = r.db; return r.result; };
  go('receiptVoucher', { whId: 'wh_fg', reason: 'opening', lines: [{ itemId: s.id('ORJ'), qty: 100, unitCost: 3 }] });
  go('cashEntry', { kind: 'capital_in', amount: 20000 });
  go('createInvoice', { whId: 'wh_fg', customerId: s.cust.id, lines: [{ itemId: s.id('ORJ'), qty: 10, unitPrice: 6 }], paid: 20, method: 'ظ†ظ‚ط¯ظٹ' });
  go('upsertEmployee', { name: 'ظ…ظˆط¸ظپ ط³ط±ظٹ', salary: 4000, hireDate: '2026-01-01', jobTitle: 'ظپظ†ظٹ' });
  const p = go('preparePayroll', { month: '2026-11' });
  go('approvePayroll', { id: p.id });
  const members = {};
  for (const [uid, role] of [['mgr-1', 'MANAGER'], ['hr-1', 'HR'], ['acc-1', 'ACCOUNTANT'], ['wh-1', 'WAREHOUSE'], ['sal-1', 'SALES']])
    members[uid] = { uid, email: `${uid}@example.com`, role, status: 'active', createdAt: 1 };
  const userCompanies = {};
  for (const uid of Object.keys(members)) userCompanies[uid] = { c1: { companyId: 'c1', name: 'ط´ط±ظƒط© ط§ظ„ظ†ظˆط±', role: members[uid].role } };
  adminDb = createFakeDb({
    companies: { c1: { id: 'c1', name: 'ط´ط±ظƒط© ط§ظ„ظ†ظˆط±', status: 'active', managerUid: 'mgr-1' } },
    companyMembers: { c1: members }, userCompanies, companyData: { c1: d }
  });
  return { s, d };
}

function boot(uid) {
  const els = {};
  const el = () => ({ style: {}, classList: { toggle: noop, add: noop, remove: noop, contains: () => false }, dataset: {}, innerHTML: '', textContent: '', value: '', hidden: false, open: false, isConnected: true, querySelector: () => null, querySelectorAll: () => [], addEventListener: noop, setAttribute: noop, appendChild: noop, showModal: noop, close: noop, click: noop, remove: noop, focus: noop });
  const get = k => (els[k] = els[k] || el());
  const calls = [];
  const fb = { db: {}, auth: {}, signOut: async () => { }, onAuthStateChanged: noop, ref: (_d, p) => ({ path: p }), get: async r => { const sn = await adminDb.database.ref(r.path).get(); return { exists: () => sn.exists(), val: () => sn.val() }; }, set: noop, update: noop, runTransaction: noop };
  const ctx = { console: { ...console, error: console.error, warn: console.warn }, Math, Date, JSON, Intl, Number, String, Array, Object, Set, Map, Promise, RegExp, Error, isFinite, isNaN, parseFloat, parseInt, setTimeout, clearTimeout, setInterval, clearInterval, TextEncoder, TextDecoder, Uint8Array, Uint32Array, DataView, ArrayBuffer, Blob: class { }, FormData: class { }, URL: { createObjectURL: () => 'blob:x', revokeObjectURL: noop } };
  ctx.window = ctx; ctx.self = ctx; ctx.globalThis = ctx;
  ctx.document = { readyState: 'loading', title: '', visibilityState: 'visible', activeElement: null, body: el(), querySelector: get, querySelectorAll: () => [], addEventListener: noop, createElement: el, getElementById: id => get('#' + id) };
  ctx.location = { hash: '' }; ctx.addEventListener = noop; ctx.removeEventListener = noop; ctx.print = noop; ctx.confirm = () => true; ctx.prompt = () => 'x';
  ctx.localStorage = { getItem: () => null, setItem: noop };
  ctx.NabdhFirebase = fb;
  ctx.fetch = async (url, init) => {
    const body = JSON.parse(init.body);
    calls.push({ url, body });
    const res = createRes();
await (url === '/api/company-staff' ? staffApi : erpOp)({ method: 'POST', headers: { authorization: init.headers.Authorization }, body }, res);
console.log('API DEBUG:', url, body.action, body.scope, res.statusCode, res.data);
return { ok: res.statusCode < 400, status: res.statusCode, json: async () => res.data };
    return { ok: res.statusCode < 400, status: res.statusCode, json: async () => res.data };
  };
  vm.createContext(ctx);
  for (const f of ['calc', 'erp-core', 'erp-ops', 'erp-ops2', 'erp-hr', 'roles', 'erp-reports', 'store', 'xlsx-lite', 'ui-kit', 'ui-pages', 'ui-pages2', 'ui-pages3', 'ui-hr', 'app'])
    vm.runInContext(fs.readFileSync(path.join(__dirname, '..', 'js', f + '.js'), 'utf8'), ctx, { filename: f + '.js' });
  const t = { ctx, els, calls, get, run: c => vm.runInContext(c, ctx), view: () => get('#view').innerHTML, nav: () => get('#nav').innerHTML };
  t.login = () => { ctx.__u = { uid, email: `${uid}@example.com`, emailVerified: true, getIdToken: async () => 'tok-' + uid }; return t.run('handleAuth(__u)'); };
  t.go = async hash => { ctx.location.hash = hash; t.run('safeRoute()'); };
  return t;
}

const PAGES = ['home', 'sales', 'purchasing', 'inventory', 'production', 'accounting', 'hr', 'reports', 'risk', 'sim', 'team', 'settings'];
const hrefs = nav => [...nav.matchAll(/href="#([a-z]+)"/g)].map(m => m[1]);
const LANDING = { MANAGER: null, HR: 'hr', ACCOUNTANT: 'accounting', WAREHOUSE: 'inventory', SALES: 'sales' };
const UIDS = { MANAGER: 'mgr-1', HR: 'hr-1', ACCOUNTANT: 'acc-1', WAREHOUSE: 'wh-1', SALES: 'sal-1' };

test('ظƒظ„ ط¯ظˆط± ظٹط±ظ‰ ط£ظ‚ط³ط§ظ…ظ‡ ظپظ‚ط· ظپظٹ ط§ظ„ط´ط±ظٹط·طŒ ظˆظٹظپطھط­ ط¹ظ„ظ‰ ظ‚ط³ظ…ظ‡طŒ ظˆط§ظ„ظ…ط¯ظٹط± ظٹط±ظ‰ ظƒظ„ ط´ظٹط، + ظپط±ظٹظ‚ ط§ظ„ط¹ظ…ظ„', async () => {
  for (const [role, uid] of Object.entries(UIDS)) {
    seed();
    const t = boot(uid);
    await t.login();

    assert.equal(t.run('ready'), true, role);
    assert.equal(t.run('scope.role'), role);
    assert.deepEqual(hrefs(t.nav()), Roles.pagesFor(role, PAGES), `ظ‚ط§ط¦ظ…ط© ${role}`);
    if (role === 'MANAGER') assert.ok(hrefs(t.nav()).includes('team') && hrefs(t.nav()).includes('hr'));
    else assert.equal(hrefs(t.nav()).length, 1, `${role} ظ‚ط³ظ… ظˆط§ط­ط¯ ظپظ‚ط·`);
    if (LANDING[role]) assert.match(t.nav(), new RegExp(`aria-current="page"[^>]*>`), 'ط§ظ„ظ‚ط³ظ… ط§ظ„ط­ط§ظ„ظٹ ظ…ط­ط¯ظژظ‘ط¯');
  }
});

test('ظ…ط­ط§ظˆظ„ط© ظپطھط­ ظ‚ط³ظ… ط؛ظٹط± ظ…ط³ظ…ظˆط­ ط¹ط¨ط± ط§ظ„ط±ط§ط¨ط· طھظڈط¹ط§ط¯ ط¥ظ„ظ‰ ظ‚ط³ظ… ط§ظ„ط¯ظˆط±طŒ ظˆظ„ط§ طھظڈط¹ط±ط¶ ط¨ظٹط§ظ†ط§طھظ‡', async () => {
  seed();
  const t = boot('sal-1');
  await t.login();
  for (const hash of ['#accounting', '#hr/employees', '#inventory', '#team', '#home', '#settings', '#production']) {
    await t.go(hash);
    assert.ok(t.view().includes('ط§ظ„ظ…ط¨ظٹط¹ط§طھ'), `${hash}: ط¹ط§ط¯ ط¥ظ„ظ‰ ط§ظ„ظ…ط¨ظٹط¹ط§طھ`);
    assert.ok(!t.view().includes('ظ…ظˆط¸ظپ ط³ط±ظٹ') && !t.view().includes('ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©'), hash);
  }

  const h = boot('hr-1');
  await h.login();
  await h.go('#accounting');
  assert.ok(h.view().includes('ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©') && !h.view().includes('ط§ظ„ظ…ظ„ط®طµ ط§ظ„ظ…ط§ظ„ظٹ'));
});

test('ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©: طµظپط­ط§طھظ‡ط§ ط§ظ„ط£ط±ط¨ط¹ طھظڈط¹ط±ط¶ ط¨ط¨ظٹط§ظ†ط§طھظ‡ط§طŒ ظˆط£ط²ط±ط§ط±ظ‡ط§ ظ…ظ†ط§ط³ط¨ط© ظ„ط¯ظˆط±ظ‡ط§طŒ ظˆظ„ط§ طھط±ط­ظٹظ„ ظ„ظ„ظ…ط­ط§ط³ط¨ط©', async () => {
  seed();
  const t = boot('hr-1');
  await t.login();
  for (const tab of ['employees', 'attendance', 'leaves', 'payroll']) {
    await t.go('#hr/' + tab);
    assert.ok(t.view().includes('ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©'), tab);
  }
  await t.go('#hr/employees');
  assert.ok(t.view().includes('ظ…ظˆط¸ظپ ط³ط±ظٹ') && t.view().includes('EMP-00001'));
  assert.ok(t.view().includes('data-act="new-employee"') && t.view().includes('data-act="del-employee"'));

  await t.go('#hr/payroll');
  assert.ok(t.view().includes('PAY-00001'));
  assert.ok(!t.view().includes('data-act="post-payroll"'), 'HR ظ„ط§ ظٹط±ط­ظ‘ظ„ ظ„ظ„ظ…ط­ط§ط³ط¨ط©');
  assert.ok(!t.view().includes('data-act="approve-payroll"'), 'ط§ظ„ظƒط´ظپ ظ…ط¹طھظ…ط¯ ط¨ط§ظ„ظپط¹ظ„');
  assert.ok(t.view().includes('data-act="view-payroll"'));
});

test('ط§ظ„ظ…ط­ط§ط³ط¨: ط§ظ„ظ…ط­ط§ط³ط¨ط© ط³ظ„ظٹظ…ط© ط¨ظ„ط§ ط¥ظ†ط°ط§ط±ط§طھ ظƒط§ط°ط¨ط©طŒ ظˆطھط¨ظˆظٹط¨ ط§ظ„ط±ظˆط§طھط¨ ط¨ط§ظ„طھط±ط­ظٹظ„ ظˆط±ط¤ظˆط³ ظپظ‚ط· ط¨ظ„ط§ ط£ط³ظ…ط§ط، ظ…ظˆط¸ظپظٹظ†', async () => {
  seed();
  const t = boot('acc-1');
  await t.login();
  await t.go('#accounting/summary');
  assert.ok(t.view().includes('ط§ظ„ظ…ظ„ط®طµ ط§ظ„ظ…ط§ظ„ظٹ'));
  assert.ok(!t.view().includes('طھظ… ط±طµط¯'), 'ظ„ط§ ط¥ظ†ط°ط§ط±ط§طھ ط³ظ„ط§ظ…ط© ظƒط§ط°ط¨ط© ظ…ظ† ط§ظ„ط¨ظٹط§ظ†ط§طھ ط§ظ„ط¬ط²ط¦ظٹط©');
  assert.ok(t.view().includes('ط³ظ„ظٹظ…ط©'));
  for (const tab of ['cash', 'expenses', 'journal', 'payroll']) { await t.go('#accounting/' + tab); assert.ok(t.view().includes('ط§ظ„ظ…ط­ط§ط³ط¨ط©'), tab); }

  await t.go('#accounting/payroll');
  assert.ok(t.view().includes('PAY-00001') && t.view().includes('data-act="post-payroll"'));
  assert.ok(!t.view().includes('ظ…ظˆط¸ظپ ط³ط±ظٹ'));

  // طھط±ط­ظٹظ„ ظپط¹ظ„ظٹ ط¹ط¨ط± ط§ظ„ظ…ط­ط±ظƒ ط¹ظ„ظ‰ ط§ظ„ط®ط§ط¯ظ…
  const before = E.cashBalance(adminDb.get('companyData/c1'));
  await t.run(`act('postPayroll', { id: DB.payroll[0].id, method: 'ظ†ظ‚ط¯ظٹ' }, 'ui-post-1')`);
  assert.equal(E.cashBalance(adminDb.get('companyData/c1')), before - 4000);
  assert.equal(t.run('DB.payroll[0].status'), 'posted');
  await t.go('#accounting/payroll');
  assert.ok(!t.view().includes('data-act="post-payroll"'), 'ط²ط± ط§ظ„طھط±ط­ظٹظ„ ط§ط®طھظپظ‰ ط¨ط¹ط¯ ط§ظ„طھط±ط­ظٹظ„');
});

test('ط£ظ…ظٹظ† ط§ظ„ظ…ط®ط§ط²ظ†: طµظپط­ط§طھ ط§ظ„ظ…ط®ط²ظˆظ† ط¨ط£طµظ†ط§ظپظ‡ ظˆط£ط±طµط¯طھظ‡ ظˆظ‚ظٹظ…ط© ط§ظ„ظ…ط®ط²ظˆظ† ط§ظ„طµط­ظٹط­ط©طŒ ظˆظ„ط§ ط´ظٹط، ظ…ظ† ط§ظ„ظ…ط¨ظٹط¹ط§طھ ط£ظˆ ط§ظ„ط£ظپط±ط§ط¯', async () => {
  const { d } = seed();
  const t = boot('wh-1');
  await t.login();
  for (const tab of ['stock', 'vouchers', 'ledger', 'warehouses']) { await t.go('#inventory/' + tab); assert.ok(t.view().includes('ط§ظ„ظ…ط®ط§ط²ظ†'), tab); }
  await t.go('#inventory/stock');
  const full = E.ensure(JSON.parse(JSON.stringify(d)));
  assert.ok(t.view().includes(String(full.items.length)));
  assert.equal(t.run("Engine.balances(DB)['1320']"), E.balances(full)['1320'], 'ظ‚ظٹظ…ط© ط§ظ„ظ…ظ†طھط¬ط§طھ ط§ظ„طھط§ظ…ط© ظ…ط·ط§ط¨ظ‚ط©');
  assert.ok(!t.view().includes('ظ…ظˆط¸ظپ ط³ط±ظٹ'));
  assert.equal(t.run('DB.sales.length'), 0);
});

test('ط§ظ„ظ…ط¨ظٹط¹ط§طھ: طµظپط­ط© ط§ظ„ظ…ط¨ظٹط¹ط§طھ ط¨ط£ط±طµط¯ط© ط§ظ„ط¹ظ…ظ„ط§ط، ط§ظ„طµط­ظٹط­ط© (ط§ظ„ظ…ط³طھط­ظ‚) ظˆط¨ظ„ط§ ظˆطµظˆظ„ ظ„ط£ظٹ ظ‚ط³ظ… ط¢ط®ط±', async () => {
  const { s, d } = seed();
  const t = boot('sal-1');
  await t.login();
  for (const tab of ['invoices', 'customers']) { await t.go('#sales/' + tab); assert.ok(t.view().includes('ط§ظ„ظ…ط¨ظٹط¹ط§طھ'), tab); }
  const full = E.ensure(JSON.parse(JSON.stringify(d)));
  assert.equal(t.run(`Engine.arBalance(DB, ${JSON.stringify(s.cust.id)})`), E.arBalance(full, s.cust.id));
  assert.ok(E.arBalance(full, s.cust.id) > 0, 'ط´ط±ط· ط§ظ„ط§ط®طھط¨ط§ط±: ظ„ظ„ط¹ظ…ظٹظ„ ظ…ط³طھط­ظ‚ ظپط¹ظ„ظٹ');

  await t.go('#sales/customers');
  assert.ok(t.view().includes('data-act="new-customer"'));
  assert.equal(t.run('DB.journal.every(j => j.lines.every(l => l.acct === "1200"))'), true);
});

test('ط§ظ„ظ…ط¯ظٹط±: ظƒظ„ ط§ظ„ط£ظ‚ط³ط§ظ… طھط¹ظ…ظ„ ط¨ظ…ط§ ظپظٹظ‡ط§ ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©طŒ ظˆطھطھط؛ظٹط± ط§ظ„ط£ط±ظ‚ط§ظ… ط¨ط¹ط¯ ط¹ظ…ظ„ظٹط© ط¨ظٹظ† ط§ظ„ظ‚ط³ظ…ظٹظ†', async () => {
  seed();
  const t = boot('mgr-1');
  await t.login();
  for (const p of ['home', 'sales', 'inventory', 'accounting', 'hr', 'reports', 'settings']) { await t.go('#' + p); assert.ok(t.view().length > 50, p); }
  await t.go('#hr/payroll');
  assert.ok(t.view().includes('data-act="post-payroll"'), 'ط§ظ„ظ…ط¯ظٹط± ظٹط±ط­ظ‘ظ„ ط£ظٹط¶ظ‹ط§');
  await t.run(`act('upsertEmployee', { name: 'ظ…ظ†ظ‰', salary: 2500, hireDate: '2026-03-01' }, 'ui-emp-1')`);
  await t.go('#hr/employees');
  assert.ok(t.view().includes('ظ…ظ†ظ‰') && t.view().includes('EMP-00002'));
});

test('ظپط±ظٹظ‚ ط§ظ„ط¹ظ…ظ„: ط§ظ„ظ…ط¯ظٹط± ظٹط±ظ‰ ط§ظ„ط£ط¹ط¶ط§ط، ظˆظٹط¯ط¹ظˆ ظˆظٹط؛ظٹظ‘ط± ط§ظ„ط¯ظˆط± ظˆظٹظˆظ‚ظپط› ط§ظ„ظ…ظˆط¸ظپ ظ„ط§ ظٹطµظ„ ظ„ط£ظٹ ظ…ظ† ط°ظ„ظƒ', async () => {
  seed(); mails = [];
  const t = boot('mgr-1');
  await t.login();
  await t.go('#team');
  await new Promise(r => setTimeout(r, 20));
  t.run('safeRoute()');
  assert.ok(t.view().includes('ظپط±ظٹظ‚ ط§ظ„ط¹ظ…ظ„') && t.view().includes('hr-1@example.com') && t.view().includes('ط§ظ„ظ…ظˆط§ط±ط¯ ط§ظ„ط¨ط´ط±ظٹط©'));
  assert.ok(t.view().includes('data-act="team-invite"'));

  // ط¯ط¹ظˆط© ظ…ظˆط¸ظپ ط¬ط¯ظٹط¯ (ظٹظ‚ط±ط£ ط§ظ„ط­ظ‚ظˆظ„ ظ…ظ† DOM)
  t.get('#teamEmail').value = 'new.sales@example.com';
  t.get('#teamRole').value = 'SALES';
  await t.run(`UI.actions['team-invite']()`);
  assert.equal(mails.length, 1);
  assert.equal(mails[0].to, 'new.sales@example.com');
  assert.ok(mails[0].text.includes('آ«ظ…ط¨ظٹط¹ط§طھآ»'));
  t.run('safeRoute()');
  assert.ok(t.view().includes('new.sales@example.com') && t.view().includes('ط£ظڈط±ط³ظ„طھ'));

  // ط¥ظٹظ‚ط§ظپ ظ…ظˆط¸ظپ ط«ظ… طھظپط¹ظٹظ„ظ‡
  await t.run(`UI.actions['team-suspend']('hr-1')`);
  assert.equal(adminDb.get('companyMembers/c1/hr-1/status'), 'suspended');
  await t.run(`UI.actions['team-activate']('hr-1')`);
  assert.equal(adminDb.get('companyMembers/c1/hr-1/status'), 'active');

  // ط§ظ„ظ…ظˆط¸ظپ: ظ„ط§ ظ‚ط³ظ… ظپط±ظٹظ‚طŒ ظˆط§ظ„ط®ط§ط¯ظ… ظٹط±ظپط¶ ظˆط§ط¬ظ‡طھظ‡ ط£ظٹط¶ظ‹ط§
  const s = boot('sal-1');
  await s.login();
  assert.ok(!hrefs(s.nav()).includes('team'));
  await s.go('#team');
  assert.ok(!s.view().includes('ظپط±ظٹظ‚ ط§ظ„ط¹ظ…ظ„'));
  const denied = await s.run(`callServer({ companyId: 'c1', action: 'list' }, currentUser, '/api/company-staff')`);
  assert.equal(denied.status, 403);
});

test('ط¥ظٹظ‚ط§ظپ ط§ظ„ظ…ظˆط¸ظپ ط£ط«ظ†ط§ط، ط¬ظ„ط³طھظ‡ ظٹط؛ظ„ظ‚ ط§ظ„ظˆط§ط¬ظ‡ط© ط¹ظ†ط¯ ط§ظ„ظ…ط²ط§ظ…ظ†ط©طŒ ظˆطھط؛ظٹظٹط± ط¯ظˆط±ظ‡ ظٹط¨ط¯ظ‘ظ„ ط£ظ‚ط³ط§ظ…ظ‡', async () => {
  seed();
  const t = boot('sal-1');
  await t.login();
  assert.deepEqual(hrefs(t.nav()), ['sales']);

  adminDb.set('companyMembers/c1/sal-1/role', 'ACCOUNTANT');
  await t.run('refreshData()');
  assert.equal(t.run('scope.role'), 'ACCOUNTANT');
  assert.deepEqual(hrefs(t.nav()), ['accounting'], 'ط§ظ„ط£ظ‚ط³ط§ظ… طھط؛ظٹظ‘ط±طھ ظ…ط¹ ط§ظ„ط¯ظˆط±');
  assert.equal(t.run('DB.sales.length > 0'), true);

  adminDb.set('companyMembers/c1/sal-1/status', 'suspended');
  await t.run('refreshData()');
  assert.equal(t.run('ready'), false);
  assert.ok(t.view().includes('طھظ… ط¥ظٹظ‚ط§ظپ ظˆطµظˆظ„ظƒ'));
});

