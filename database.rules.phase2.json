{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !root.child('serverOps').child(auth.uid).exists()",
        "stock": {
          "$itemId": {
            "$whId": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      }
    },
    "backups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "pre_v2": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()"
        }
      }
    },
    "companyData": {
      "$companyId": {
        ".read": false,
        ".write": false
      }
    },
    "companyMembers": {
      "$companyId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "userCompanies": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "serverOps": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    }
  }
}
